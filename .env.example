# Local development uses .data/atelier.db and a locally generated session secret.
# Vercel requires a persistent libSQL/Turso database and a secure session secret.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
APP_URL=http://localhost:3000
COMMERCE_MODE=preview
# Activate live commerce only after approving products and operational policies.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PAYMENT_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Vercel/GitHub automatic deployment is configured by the connected project.
LAUNCH_APPROVED=false
SHIPPING_FEE_COP=25000
FREE_SHIPPING_COP=1200000

# Optional hosted photorealistic try-on. Server-side only; add securely in Vercel.
FASHN_API_KEY=

# Default: key-only hosted API activation. Optional separate GPU worker (see docs/SELF-HOSTED-VTON.md).
TRY_ON_PROVIDER=fashn
VTON_SERVICE_URL=
VTON_SERVICE_KEY=
